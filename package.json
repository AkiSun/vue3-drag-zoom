{
  "name": "vue3-drag-zoom",
  "private": false,
  "version": "1.0.6",
  "description": "A Drag & Zoom toolkit for Vue 3",
  "author": "AkiSun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkiSun/vue3-drag-zoom.git"
  },
  "homepage": "https://github.com/AkiSun/vue3-drag-zoom#readme",
  "files": [
    "dist"
  ],
  "module": "./dist/vue3-drag-zoom.es.js",
  "main": "./dist/vue3-drag-zoom.umd.js",
  "types": "./typings/packages/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue3-drag-zoom.es.js",
      "require": "./dist/vue3-drag-zoom.umd.js",
      "types": "./typings/packages/index.d.ts"
    },
    "./props": {
      "types": "./packages/props.d.ts"
    }
  },
  "keywords": [
    "vue3",
    "typescript",
    "drag",
    "zoom"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dts": "vue-tsc --declaration --emitDeclarationOnly",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "vue": "^3.2.41"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.50.0",
    "eslint-plugin-vue": "^9.0.0",
    "happy-dom": "^20.6.0",
    "prettier": "^3.0.0",
    "typescript": "^4.6.4",
    "vite": "^3.2.3",
    "vitest": "^1.6.0",
    "vue-tsc": "^1.0.9"
  }
}
